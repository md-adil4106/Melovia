# ==============================================================================
# Melovia Environment Variables (.env.example)
# Copy this file to .env for local development. Never commit .env!
# ==============================================================================

# --- ENV ---
ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- DATABASE ---
# PostgreSQL 16 (No Redis, No pgvector)
DATABASE_URL=postgresql+psycopg://melovia_user:melovia_password@localhost:5432/melovia_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# --- LLM ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-llm-api-key-here
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# --- PLATFORM ---
# Adapter settings for external music platforms (Spotify, Apple Music, etc.)
PLATFORM_DEFAULT=spotify
PLATFORM_CLIENT_ID=your-platform-client-id
PLATFORM_CLIENT_SECRET=your-platform-client-secret
PLATFORM_REDIRECT_URI=http://localhost:8000/platforms/callback

# --- CATALOG ---
CATALOG_BUNDLE_PATH=data/bundles/v1
CATALOG_VERSION=v1
CATALOG_EMBEDDING_DIM=128
CATALOG_CHECKSUM=
